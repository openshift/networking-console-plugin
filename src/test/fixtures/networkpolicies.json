{
  "kind": "NetworkPolicyList",
  "apiVersion": "networking.k8s.io/v1",
  "metadata": {},
  "items": [
    {
      "metadata": {
        "name": "allow-web",
        "namespace": "cy-test-ns",
        "annotations": {}
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "web"
          }
        },
        "ingress": [{}],
        "egress": [{}],
        "policyTypes": ["Ingress", "Egress"]
      }
    },
    {
      "metadata": {
        "name": "deny-all",
        "namespace": "cy-test-ns",
        "annotations": {}
      },
      "spec": {
        "podSelector": {},
        "policyTypes": ["Ingress"]
      }
    }
  ]
}
