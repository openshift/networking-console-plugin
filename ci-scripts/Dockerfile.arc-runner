# Custom ARC Runner Image
# Pre-installs oc, helm, Node.js, and Cypress dependencies
# Reduces job startup time and improves reproducibility
#
# Build: docker build -t custom-arc-runner:latest -f ci-scripts/Dockerfile.arc-runner .
# Push: docker tag custom-arc-runner:latest ttl.sh/custom-arc-runner:1h && docker push ttl.sh/custom-arc-runner:1h

# Use the official ARC runner image as base
FROM ghcr.io/actions/actions-runner:latest

USER root

# Install system dependencies for oc, helm, and Cypress
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    git \
    gnupg \
    lsb-release \
    xvfb \
    libxss1 \
    libappindicator1 \
    libindicator7 \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libappindicator1 \
    libindicator7 \
    fonts-liberation \
    xdg-utils \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install OpenShift CLI (oc)
RUN set -e; \
    OC_VERSION="4.14"; \
    OC_DIR="/usr/local/bin"; \
    curl -sL "https://mirror.openshift.com/pub/openshift-v4/x86_64/clients/ocp/stable/openshift-client-linux.tar.gz" \
    -o /tmp/oc.tar.gz && \
    tar -xzf /tmp/oc.tar.gz -C "${OC_DIR}" oc kubectl && \
    chmod +x "${OC_DIR}"/oc "${OC_DIR}"/kubectl && \
    rm -f /tmp/oc.tar.gz && \
    oc version --client

# Install Helm
RUN set -e; \
    HELM_VERSION="3.14"; \
    curl -sL "https://get.helm.sh/helm-v${HELM_VERSION}.0-linux-amd64.tar.gz" \
    -o /tmp/helm.tar.gz && \
    tar -xzf /tmp/helm.tar.gz -C /tmp && \
    mv /tmp/linux-amd64/helm /usr/local/bin/ && \
    chmod +x /usr/local/bin/helm && \
    rm -rf /tmp/helm.tar.gz /tmp/linux-amd64 && \
    helm version

# Install Node.js and npm (version 18.x)
RUN set -e; \
    NODE_VERSION="18"; \
    curl -sL "https://deb.nodesource.com/setup_${NODE_VERSION}.x" | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    node --version && npm --version

# Install Cypress (headless browser dependencies)
RUN npm install -g cypress@latest && \
    cypress verify && \
    npm cache clean --force

# Set environment variables for Cypress and FIPS
ENV CYPRESS_INSTALL_BINARY=0 \
    OPENSSL_FORCE_FIPS_MODE=0 \
    GOLANG_FIPS=0 \
    RUNNER_ALLOW_RUNASROOT=true

# Switch back to runner user
USER runner

# Verify all tools are installed and accessible
RUN set -e; \
    echo "=== Tool Verification ==="; \
    echo "oc: $(oc version --client)"; \
    echo "kubectl: $(kubectl version --client)"; \
    echo "helm: $(helm version --short)"; \
    echo "node: $(node --version)"; \
    echo "npm: $(npm --version)"; \
    echo "cypress: $(cypress --version)"; \
    echo "git: $(git --version)"; \
    echo "curl: $(curl --version | head -1)"; \
    echo "jq: $(jq --version)"

ENTRYPOINT ["/home/runner/run.sh"]
